# Required
TELEGRAM_BOT_TOKEN=123456:ABC...
GROQ_API_KEY=gsk_...

# Optional
# GROQ_MODEL=whisper-large-v3-turbo
# WHISPER_LANGUAGE=it            # ISO-639-1; unset = auto-detect
# ALLOWED_USER_IDS=11111,22222   # unset = anyone can use the bot
# CHUNK_SECONDS=20               # 0 = never split long recordings
# MAX_PARALLEL_REQUESTS=4        # concurrent Groq requests across all chats
# RUST_LOG=info
